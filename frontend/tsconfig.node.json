
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo", // Sparar information för snabbare byggen
    "target": "es2023", // JavaScript-version som koden riktas mot
    "lib": ["ES2023"], // Tillgängliga JavaScript-typer
    "types": ["node"], // Node.js-typer
    "skipLibCheck": true, // Hoppar över typkontroll av bibliotekens deklarationsfiler

    /* Bundler mode */
    "module": "nodenext", // Modulsystem enligt Node.js
    "allowImportingTsExtensions": true, // Tillåter .ts i importvägar
    "verbatimModuleSyntax": true, // Bevarar imports och exports enligt TS-regler
    "moduleDetection": "force", // Behandlar filer som moduler
    "noEmit": true, // Skapar inga JavaScript-filer

    /* Linting */
    "noUnusedLocals": true, // Varnar för oanvända lokala variabler
    "noUnusedParameters": true, // Varnar för oanvända parametrar
    "erasableSyntaxOnly": true, // Tillåter TS-syntax som kan tas bort utan kodomvandling
    "noFallthroughCasesInSwitch": true // Förhindrar oavsiktlig fortsättning mellan switch-fall
  },
  "include": ["vite.config.ts"] // Den fil som konfigurationen gäller
}
